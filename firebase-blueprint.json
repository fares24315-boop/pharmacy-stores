{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User account information and role in the pharmacy system",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth User UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User full name"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "pharmacist"],
          "description": "Role determining access permissions in the pharmacy"
        },
        "createdAt": {
          "type": "string",
          "description": "Account creation timestamp"
        }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Collection of user profiles containing their assigned role (admin or pharmacist)"
    }
  }
}
